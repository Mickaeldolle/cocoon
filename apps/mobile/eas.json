{
  "cli": { "version": ">= 14.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "ios-simulator": {
      "environment": "preview",
      "ios": { "simulator": true }
    },
    "production": {}
  }
}
