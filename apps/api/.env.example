# Local development, without Docker. PostgreSQL must be reachable from this machine.
APP_ENV=
DATABASE_URL=
JWT_SECRET=s

# Only needed for browser previews. Keep the list explicit; do not use a wildcard.
CORS_ORIGINS=

# Exact origin of the Expo web site using WebAuthn, never the API origin.
# HTTPS is required outside localhost development. Set this on the API deployment.
WEBAUTHN_ORIGIN=

# Optional self-hosted OpenAI-compatible provider on the private Docker network.
# Example base URL: http://llm:8000/v1. Leave LLM_API_KEY empty when the private runtime has no key.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Assistant engine. The MVP uses the server-side OpenAI-compatible adapter above.
ASSISTANT_RUNTIME=

# Optional OpenAI-compatible speech-to-text provider. Audio is streamed through memory only;
# never expose this provider or its key to Expo/mobile code.
STT_API_URL=
STT_API_KEY=
STT_MODEL=
STT_TIMEOUT_SECONDS=

# Optional internal scrape token (at least 32 characters); metrics stay disabled when empty.
METRICS_TOKEN=

# Expo's public push gateway; it receives only generic reminder/brief payloads.
EXPO_PUSH_ENDPOINT=
WORKER_INTERVAL_SECONDS=
