# Local development, without Docker. PostgreSQL must be reachable from this machine.
APP_ENV=
DATABASE_URL=
JWT_SECRET=s

# Only needed for browser previews. Keep the list explicit; do not use a wildcard.
CORS_ORIGINS=

# Exact origin of the Expo web site using WebAuthn login and protected-space unlock, never the API origin.
# HTTPS is required outside localhost development. Set this on the API deployment.
WEBAUTHN_ORIGIN=

# Local Ollama or any OpenAI-compatible runtime (LM Studio/vLLM).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
# Legacy alias, retained for existing installations.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_CONNECTION_TIMEOUT=20
LLM_READ_TIMEOUT=600
LLM_POOL_TIMEOUT=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_STREAMING=true
LLM_HEALTHCHECK_ENABLED=true
ASSISTANT_REQUESTS_PER_MINUTE=30

# Assistant engine. The MVP uses the server-side OpenAI-compatible adapter above.
ASSISTANT_RUNTIME=

# Optional OpenAI-compatible speech-to-text provider. Audio is streamed through memory only;
# never expose this provider or its key to Expo/mobile code.
STT_API_URL=
STT_API_KEY=
STT_MODEL=
STT_TIMEOUT_SECONDS=

# Optional internal scrape token (at least 32 characters); metrics stay disabled when empty.
METRICS_TOKEN=

# Minimal audit metadata retention; run the prune command daily.
AUDIT_RETENTION_DAYS=90
# JSON list of trusted proxy CIDRs, for example ["192.0.2.10/32"].
# Empty by default: X-Forwarded-For is ignored and only the direct peer IP is recorded.
AUDIT_TRUSTED_PROXY_CIDRS=[]

# Expo's public push gateway; it receives only generic reminder/brief payloads.
EXPO_PUSH_ENDPOINT=
WORKER_INTERVAL_SECONDS=

# Browser push: one P-256 VAPID key pair for the API and web app.
# Keep the private key only on the API and use a real contact URI as subject.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Shared only by the hosted API and a trusted scheduler (for example Supabase Cron).
NOTIFICATION_WORKER_TOKEN=
INTERNAL_WORKER_TOKEN=
