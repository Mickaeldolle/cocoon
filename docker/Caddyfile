{$CADDY_SITE_ADDRESS} {
  encode zstd gzip
  # Keep worker triggers and metrics on the private API network.
  handle /api/internal/* {
    respond 404
  }
  handle /internal/* {
    respond 404
  }
  handle /api/* {
    reverse_proxy api:8000
  }
  handle /health* {
    reverse_proxy api:8000
  }
  handle {
    root * /srv/cocoon
    try_files {path} /index.html
    file_server
  }
}
