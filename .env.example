# Used by Docker Compose. Change these before any non-local deployment.
POSTGRES_DB=cocoon
POSTGRES_USER=cocoon
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://cocoon:change-me-before-production@postgres:5432/cocoon
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional private OpenAI-compatible model runtime, reachable only from the API network.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# The MVP uses the server-side local OpenAI-compatible provider only.
ASSISTANT_RUNTIME=local
# Optional private OpenAI-compatible speech-to-text runtime. Keep credentials server-side.
STT_API_URL=
STT_API_KEY=
STT_MODEL=
# Optional internal scrape token (at least 32 characters); metrics stay disabled when empty.
METRICS_TOKEN=
CADDY_SITE_ADDRESS=:80
COCOON_HTTP_PORT=8080
COCOON_HTTPS_PORT=8443

# Only public, non-sensitive values may be added to apps/mobile/.env.
EXPO_PUBLIC_API_URL=http://localhost:8080
