# Used by Docker Compose. Change these before any non-local deployment.
POSTGRES_DB=cocoon
POSTGRES_USER=cocoon
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://cocoon:change-me-before-production@postgres:5432/cocoon
# Required only with docker/compose.supabase.yml; use a separate DDL-capable role.
MIGRATION_DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
# Exact browser origin for passkeys; a separate Vercel web project needs its own origin.
WEBAUTHN_ORIGIN=
CORS_ORIGINS=[]
# Web Push is optional. Keep the VAPID private key server-side.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
NOTIFICATION_WORKER_TOKEN=
# Optional private trigger for one queued capture or memory-index job per call.
INTERNAL_WORKER_TOKEN=
# Choose one private model runtime. The frontend never receives these values.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
LLM_CONNECTION_TIMEOUT=20
LLM_READ_TIMEOUT=600
LLM_POOL_TIMEOUT=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_STREAMING=true
LLM_HEALTHCHECK_ENABLED=true
ASSISTANT_REQUESTS_PER_MINUTE=30
# The MVP uses the server-side local OpenAI-compatible provider only.
ASSISTANT_RUNTIME=local
# Optional local memory embeddings, independent from the conversation model.
# Keep disabled until PostgreSQL/pgvector and the local runtime are qualified.
MEMORY_EMBEDDINGS_ENABLED=false
MEMORY_VECTOR_ENABLED=false
MEMORY_EMBEDDING_BASE_URL=http://host.docker.internal:11434
MEMORY_EMBEDDING_MODEL=qwen3-embedding:0.6b
MEMORY_EMBEDDING_REVISION=1
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_TIMEOUT_SECONDS=60
MEMORY_QUERY_TIMEOUT_SECONDS=3
MEMORY_MIN_SIMILARITY=0.65
# Legacy name: this is a conservative UTF-8 byte budget for structured memories.
MEMORY_CONTEXT_TOKENS=1200
# Total system + user prompt bytes. Set below the model context window; reserve output separately.
ASSISTANT_PROMPT_MAX_BYTES=24000
MEMORY_WORKER_INTERVAL_SECONDS=10
# Optional private OpenAI-compatible speech-to-text runtime. Keep credentials server-side.
STT_API_URL=
STT_API_KEY=
STT_MODEL=
# Optional internal scrape token (at least 32 characters); metrics stay disabled when empty.
METRICS_TOKEN=
CADDY_SITE_ADDRESS=:80
COCOON_HTTP_PORT=8080
COCOON_HTTPS_PORT=8443
